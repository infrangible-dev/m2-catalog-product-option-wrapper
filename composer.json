{
    "name": "infrangible/m2-catalog-product-option-wrapper",
    "description": "Places every custom option on the product page in its own identifiable container, so themes and other Infrangible option modules can target and style individual options.",
    "type": "magento2-module",
    "version": "2.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-option-wrapper",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.0",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionWrapper\\": "src"
        }
    }
}
